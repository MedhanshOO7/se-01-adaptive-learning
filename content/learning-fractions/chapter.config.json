  "quizzes": [
    {
      "id": "chapter-check",
      "title": "Your chapter check",
      "questions": [
        {
          "id": "check-parts",
          "type": "single",
          "prompt": "A whole is divided into four equal pieces. What is one piece?",
          "topics": [
            "equal-parts"
          ],
          "weight": 1,
          "options": [
            "1/4",
            "1/3",
            "4/1"
          ],
          "answer": 0,
          "explanation": "Four equal pieces make one whole, so each piece is one quarter."
        },
        {
          "id": "check-equiv",
          "type": "multiple",
          "prompt": "Select every fraction equivalent to 1/2.",
          "topics": [
            "equivalence"
          ],
          "weight": 1,
          "options": [
            "2/4",
            "3/6",
            "2/3"
          ],
          "answer": [
            0,
            1
          ],
          "hint": "Multiply the numerator and denominator by the same number.",
          "explanation": "2/4 and 3/6 both describe one half."
        },
        {
          "id": "check-order",
          "type": "ordering",
          "prompt": "Arrange these fractions from smallest to largest.",
          "topics": [
            "comparison"
          ],
          "weight": 1,
          "options": [
            "3/4",
            "1/4",
            "1/2"
          ],
          "answer": [
            1,
            2,
            0
          ],
          "explanation": "In quarters: 1/4, 2/4, 3/4."
        },
        {
          "id": "check-simple",
          "type": "numeric",
          "prompt": "Write 6/8 in simplest form.",
          "topics": [
            "simplifying"
          ],
          "weight": 1,
          "answer": "3/4",
          "simplestForm": true,
          "explanation": "Divide both terms by 2 to get 3/4."
        },
        {
          "id": "check-add",
          "type": "numeric",
          "prompt": "What is 1/4 + 2/4?",
          "topics": [
            "addition"
          ],
          "weight": 1,
          "answer": "3/4",
          "explanation": "Add the numerators when the denominators match."
        },
        {
          "id": "check-reason",
          "type": "single",
          "level": "hots",
          "prompt": "Asha says 1/3 is larger than 1/2 because 3 is larger than 2. Which explanation resolves the mistake?",
          "topics": [
            "reasoning"
          ],
          "weight": 1,
          "options": [
            "More equal pieces means each piece is smaller.",
            "A larger denominator always means a larger fraction.",
            "The fractions are equal."
          ],
          "answer": 0,
          "explanation": "Dividing the same whole into three equal parts makes smaller pieces than dividing it into two."
        }
      ]
    },
