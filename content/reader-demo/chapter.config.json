  "quizzes": [
    {
      "id": "check",
      "title": "Try it yourself",
      "questions": [
        {
          "id": "parts",
          "type": "single",
          "prompt": "A whole is cut into four equal pieces. What fraction is one piece?",
          "options": [
            "1/4",
            "1/2",
            "4/1"
          ],
          "answer": 0,
          "topics": [
            "parts",
            "meaning"
          ],
          "explanation": "One of four equal pieces is one quarter.",
          "weight": 1
        },
        {
          "id": "equivalent",
          "type": "multiple",
          "prompt": "Which fractions are equal to one half?",
          "options": [
            "2/4",
            "3/6",
            "2/3"
          ],
          "answer": [
            0,
            1
          ],
          "topics": [
            "equivalence"
          ],
          "explanation": "Both 2/4 and 3/6 represent the same half.",
          "weight": 1
        },
        {
          "id": "order",
          "type": "ordering",
          "prompt": "Arrange these fractions from smallest to largest.",
          "options": [
            "3/4",
            "1/4",
            "1/2"
          ],
          "answer": [
            1,
            2,
            0
          ],
          "topics": [
            "order",
            "compare"
          ],
          "explanation": "For the same whole, one quarter is less than one half, which is less than three quarters.",
          "weight": 1
        },
        {
          "id": "reason",
          "type": "numeric",
          "level": "hots",
          "prompt": "A recipe uses 1/2 cup. You double it. How many cups do you need?",
          "answer": "1",
          "topics": [
            "reason"
          ],
          "hint": "Two halves make a whole.",
          "explanation": "Twice one half is one whole cup.",
          "weight": 1
        }
      ]
    }
  ],
